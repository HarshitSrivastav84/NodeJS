<%- include('partials/head')%>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">
  <%- include('partials/nav')%>

  <main class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md mx-auto mx-10">
    
    <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">
      Register your home here
    </h1>

    <form action="/host/add-home" method="POST" class="space-y-4">

      <input
        type="text"
        name="houseName"
        placeholder="Enter the name of your house"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg 
               focus:outline-none focus:ring-2 focus:ring-blue-500"
      />

      <input
        type="number"
        name="price"
        placeholder="Enter price per night"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg 
               focus:outline-none focus:ring-2 focus:ring-blue-500"
      />

      <input
        type="text"
        name="location"
        placeholder="Enter location of the house"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg 
               focus:outline-none focus:ring-2 focus:ring-blue-500"
      />

      <input
        type="number"
        name="rating"
        placeholder="Enter the rating"
        min="0"
        max="5"
        step="0.1"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg 
               focus:outline-none focus:ring-2 focus:ring-blue-500"
      />

      <input
        type="text"
        name="photoURL"
        placeholder="Enter photo URL"
        min="0"
        max="5"
        step="0.1"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg 
               focus:outline-none focus:ring-2 focus:ring-blue-500"
      />

      <input
        type="submit"
        value="Register Home"
        class="w-full bg-blue-600 text-white font-semibold py-3 rounded-lg
               cursor-pointer hover:bg-blue-700 transition duration-200"
      />

    </form>
  </main>

</body>
</html>