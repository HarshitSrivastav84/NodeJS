<%- include('../partials/head') %>
  </head>

  <body class="bg-slate-50 min-h-screen text-slate-800">

    <%- include('../partials/nav') %>

      <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">

        <!-- Back Button -->
        <a href="/"
          class="inline-flex items-center gap-2 text-slate-600 hover:text-red-500 font-medium mb-6 transition">
          ← Back to homes
        </a>

        <!-- Main Card -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden">

          <!-- Image Section -->
          <div class="relative">

            <img src="<%= home.photoURL %>" alt="<%= home.houseName %>"
              class="w-full h-[350px] sm:h-[500px] object-cover">

            <!-- Rating Badge -->
            <div class="absolute top-5 right-5 bg-white/95 backdrop-blur-sm 
                    px-4 py-2 rounded-full shadow-md font-semibold">
              ⭐ <%= home.rating %>
            </div>

          </div>


          <!-- Details Section -->
          <div class="p-6 sm:p-10">

            <!-- Title -->
            <div class="mb-8">

              <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 mb-3">
                <%= home.houseName %>
              </h1>

              <p class="text-lg text-slate-500 flex items-center gap-2">
                📍 <%= home.location %>
              </p>

            </div>


            <!-- Information Boxes -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">

              <!-- Location -->
              <div class="bg-slate-50 rounded-2xl p-5 border border-slate-100">
                <p class="text-sm text-slate-500 mb-1">
                  Location
                </p>

                <p class="font-semibold text-lg">
                  <%= home.location %>
                </p>
              </div>

              <!-- Rating -->
              <div class="bg-slate-50 rounded-2xl p-5 border border-slate-100">

                <p class="text-sm text-slate-500 mb-1">
                  Guest Rating
                </p>

                <p class="font-semibold text-lg">
                  ⭐ <%= home.rating %> / 5
                </p>

              </div>


              <!-- Price -->
              <div class="bg-slate-50 rounded-2xl p-5 border border-slate-100">

                <p class="text-sm text-slate-500 mb-1">
                  Price
                </p>

                <p class="font-bold text-xl text-red-500">
                  ₹<%= home.price %>
                    <span class="text-sm text-slate-500 font-normal">
                      / night
                    </span>
                </p>

              </div>

            </div>


            <!-- Description -->
            <div class="border-t border-slate-200 pt-8 mb-8">

              <h2 class="text-2xl font-bold mb-3">
                About this home
              </h2>

              <p class="text-slate-600 leading-relaxed text-lg">
                Welcome to <%= home.houseName %>. Enjoy a comfortable and
                  relaxing stay in <%= home.location %>. This home is a great
                    choice for guests looking for a pleasant and convenient place
                    to stay.
              </p>

            </div>


            <!-- Bottom Section -->
            <div class="border-t border-slate-200 pt-8
                    flex flex-col sm:flex-row
                    items-center justify-between gap-6">

              <!-- Price -->
              <div>
                <p class="text-sm text-slate-500">
                  Price per night
                </p>

                <p class="text-3xl font-bold text-slate-900">
                  ₹<%= home.price %>
                </p>
              </div>

              <form action="/favourites">
                <button class="p-2 rounded-3xl bg-red-500 hover:bg-red-600">
                  Add to favourites
                </button>
              </form>

            </div>

          </div>

        </div>

      </main>

  </body>

  </html>





